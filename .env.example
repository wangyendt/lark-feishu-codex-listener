# Copy to .env and fill in your credentials.
# Note: this `.env` is loaded from the directory where you run `python lark_codex_listener.py`.

# Feishu/Lark app credentials
LARK_APPID=cli_xxx
LARK_APPSECRET=xxx

# Which group(s) to listen (match exact Feishu group name).
# If you set LARK_VALID_GROUP_NAMES, it overrides LARK_GROUP_NAME.
LARK_GROUP_NAME=测试4
# LARK_VALID_GROUP_NAMES=测试4,测试3

# Optional: pin to a specific chat_id (recommended if there are multiple groups with the same name).
# LARK_CHAT_ID=oc_xxx

# Only trigger Codex when the message @mentions this specific bot name (recommended).
# This fixes the issue where `@_user_1` would match any @mention.
LARK_CODEX_TRIGGER_MENTION_NAME=algo_bot_conan

# Alternatively, pin by mentioned open_id (more stable than display name).
# LARK_CODEX_TRIGGER_MENTION_OPEN_ID=ou_xxx

# Fallback: mention placeholder in message text when you @mention someone in Feishu.
# Usually you don't need this if `mentions` is present in the event payload.
LARK_CODEX_MENTION_KEY=@_user_1

# Codex execution timeout per question (seconds).
LARK_CODEX_TIMEOUT_SEC=600

# Optional: run Codex in this directory instead of the listener script directory.
# If relative, it's resolved relative to this .env file.
# Note: `.codex_threads.json` and `codex_artifacts/` will be created under WORKING_DIR.
WORKING_DIR=/absolute/path/to/your/project

# Default Codex model (optional). You can also switch via Feishu:
#   @_user_1 /model <name>
#   @_user_1 /model-reset <name>
# LARK_CODEX_MODEL_DEFAULT=gpt-5-codex-mini

# Codex prompt controls (optional, used by codex_qa.mjs):
CODEX_DISABLE_GUARDRAILS=0
# CODEX_PROMPT_SUFFIX=

# Optional: OSS credentials (only needed if you extend the bot to use OSS)
# OSS_ENDPOINT=oss-cn-xxx.aliyuncs.com
# OSS_BUCKETNAME=your-bucket
# OSS_ACCESSKEYID=xxx
# OSS_ACCESSKEYSECRET=xxx
